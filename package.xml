<?xml version="1.0"?>
<package format="2">
  <name>inspection_nav</name>
  <version>0.1.0</version>
  <description>ROS1 Noetic inspection navigation with separated goal recorder and goal sender nodes.</description>

  <maintainer email="zy@todo.todo">zy</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>

  <depend>actionlib</depend>
  <depend>geometry_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>message_runtime</exec_depend>

  <build_depend>yaml-cpp</build_depend>
  <build_export_depend>yaml-cpp</build_export_depend>
  <exec_depend>yaml-cpp</exec_depend>

  <export/>
</package>
